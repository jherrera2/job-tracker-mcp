# Copy this file to .env and adjust. .env is git-ignored; never commit real keys.

# Used by docker-compose.yml to create the local Postgres container.
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=jobsearch
POSTGRES_DB=jobsearch
POSTGRES_PORT=5432

# The app's database (required).
DATABASE_URL=postgres://jobsearch:jobsearch@localhost:5432/jobsearch

# A separate database for `npm run test:integration`. The tests create and drop schemas in it,
# so it must never point at real data. Its name must end in "_test".
TEST_DATABASE_URL=postgres://jobsearch:jobsearch@localhost:5432/jobsearch_test

# Only for running the evals (step 8). The server itself makes no AI calls: the fit check is written
# by the user's own chat model (ADR-001), so normal use needs no key. Never logged or stored.
ANTHROPIC_API_KEY=
