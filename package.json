{
  "name": "job-tracker-mcp",
  "version": "0.1.0",
  "description": "A local MCP server that checks how well a job fits your master résumé and your own top-5 criteria.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/demo/seed-cli.ts",
    "evals": "tsx --env-file-if-exists=.env evals/src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "entities": "8.1.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.9",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
